# Telegram Bot Configuration
# Получите токен у @BotFather в Telegram
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Database URL (aiosqlite для разработки, asyncpg для продакшена)
# Примеры:
# SQLite: sqlite+aiosqlite:///./treasurybot.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/treasurybot
DATABASE_URL=sqlite+aiosqlite:///./treasurybot.db

# Telegram ID администраторов через запятую (узнать свой ID можно через @userinfobot)
ADMIN_IDS=123456789

# Необязательно: прокси для обхода блокировок api.telegram.org (HTTP или SOCKS5)
# PROXY_URL=http://127.0.0.1:7890
# PROXY_URL=socks5://127.0.0.1:10808

# Logging & Timezone
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

# Webhook (для продакшена / деплоя на Railway / Render)
USE_WEBHOOK=false
WEBHOOK_DOMAIN=
WEBHOOK_PATH=/webhook
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8000
